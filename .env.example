# ═══════════════════════════════════════════════════════════════════
# EvoTrader — keys and environment settings
# ═══════════════════════════════════════════════════════════════════
# Easiest: run `./run.sh setup`. It asks for these and saves them to
# <data folder>/.env, readable only by you.
#
# By hand: copy this file to <data folder>/.env (default: data/.env) and fill
# it in. A .env in the project folder also works; the data folder's wins.
# NEVER commit a real .env or paste it anywhere.
# ═══════════════════════════════════════════════════════════════════

# ── 1. AI provider keys (at least one) ─────────────────────────────
# Which agent uses which provider is set by `model:` in settings.yaml.
# Google Gemini — the default. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Anthropic Claude — for "anthropic/..." models. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI ChatGPT — for "openai/..." models (experimental). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 2. Web console ─────────────────────────────────────────────────
# Password for the console and its API. The console can approve trades, so
# always set one. Empty means NO login at all.
DASHBOARD_PASSWORD=

# Port for the web console (default 8080).
EVOTRADER_PORT=8080

# Who can reach the console. Empty = only this computer (127.0.0.1). Set
# 0.0.0.0 to use it from other devices on a network you trust (e.g. Tailscale);
# the app then refuses to start without DASHBOARD_PASSWORD.
EVOTRADER_HOST=

# Other web addresses allowed to call the console's API (comma-separated), for
# a separate front end in development. Empty = none, the safe default.
EVOTRADER_CORS_ORIGINS=

# ── 3. Market data (optional) ──────────────────────────────────────
# Alpha Vantage: news and market data. Comma-separate several keys to rotate
# them under the rate limit. Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── 4. Broker (optional) ───────────────────────────────────────────
# Leave empty: the first start shows a link to Robinhood's own sign-in page
# and caches the login in ~/.evotrader/oauth/. Only for overriding with a
# static token.
ROBINHOOD_AUTH_TOKEN=

# ── 5. Testing (optional) ──────────────────────────────────────────
# Pretend it is this time (ISO-8601), e.g. 2026-07-20T10:30:00-04:00.
# Setting it always forces practice (sim) mode.
EVOTRADER_MOCK_TIME=

# The data folder itself is chosen before this file is read, so set
# EVOTRADER_DATA_DIR in your shell (or pass --data-dir), not here.
